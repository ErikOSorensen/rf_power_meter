(footprint "W5500-EVB-Pico_Socketed"
	(version 20240108)
	(generator "pcbnew")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "WIZnet W5500-EVB-Pico (RP2040 + W5500, Raspberry Pi Pico pinout) plugged into two 1x20 2.54 mm pin sockets, rows 17.78 mm apart. Origin at pin 1 (GP0, USB end). Pico PCB 21 x 75 mm on F.Fab/F.SilkS; its underside is 11.0 mm above this board. The RJ45 jack overhangs the Pico PCB end by 4.7 mm (Dwgs.User) and may project past this board's edge through the enclosure wall. Courtyard covers the sockets only. SWD pins 41-43 are on top of the module and have no pads. https://docs.wiznet.io/Product/iEthernet/W5500/w5500-evb-pico")
	(tags "WIZnet W5500 EVB Pico RP2040 ethernet module socket")
