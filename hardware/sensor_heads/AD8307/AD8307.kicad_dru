(version 1)

# Keep copper pours away from RF traces. A pour at the default 0.3 mm
# clearance turns the microstrip into a coplanar line and lowers Z0.
# Three times the dielectric height makes the pour's effect negligible.
(rule rf_pour_clearance
  (condition "A.NetClass == 'RF' && B.Type == 'Zone'")
  (constraint clearance (min 0.6mm)))

# RF nets stay on the top layer over the L2 ground: no vias, and the
# microstrip width is fixed even if someone drags a track.
(rule rf_nets
  (condition "A.NetClass == 'RF'")
  (constraint via_count (max 0))
  (constraint track_width (min 0.35mm) (max 0.35mm)))

# Connector pads that sit on the board edge by design.
# Würth mid-mount RJ45: the shield pads are flush with the notch wall.
(rule rj45_shield_pads_on_notch
  (condition "A.memberOfFootprint('J2') && A.Pad_Number == 'SH'")
  (constraint edge_clearance (min 0mm)))

# Amphenol edge-mount SMA: all pads straddle the board edge.
(rule sma_pads_on_edge
  (condition "A.memberOfFootprint('J1')")
  (constraint edge_clearance (min 0mm)))

# Allow narrower power tracks where they enter fine-pitch packages.
(rule power_neckdown
  (condition "A.NetClass == 'Power' && (A.intersectsCourtyard('U3') || A.intersectsCourtyard('U4') || A.intersectsCourtyard('U1'))")
  (constraint track_width (min 0.2mm) (opt 0.3mm)))

